{
  // Off Grid Console — audit-ci config (#226).
  //
  // Fails the gate (pre-push + CI) on any HIGH or CRITICAL npm advisory in the
  // dependency tree. Moderate/low are surfaced by `npm audit` but do NOT block —
  // they are tracked as a burn-down, not a hard stop (blocking on every moderate
  // transitive advisory would gate every push on upstream release cadence we do
  // not control). Ratchet the level down as the tree is cleaned up.
  //
  // BASELINE 2026-07-10: 0 high, 0 critical, 16 moderate (all in the @temporalio
  // dependency tree — @temporalio/common/proto/workflow/core-bridge/nexus, a
  // single upstream advisory chain; no first-party fix, awaiting a temporalio
  // release bump). Logged in docs/GAPS_BACKLOG.md (G-AUDIT-*).
  "$schema": "https://raw.githubusercontent.com/IBM/audit-ci/main/docs/schema.json",
  "high": true,
  "critical": true,
  // Report moderate/low so they stay visible in the log, without failing.
  "report-type": "important",
  "allowlist": []
}
